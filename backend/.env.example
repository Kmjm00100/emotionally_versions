# Example environment variables for Emotionally backend
# Copy this file to .env (same directory) and fill in real values.
# ---------------------------------------------------------------
# MongoDB connection string:
# For Atlas (SRV):
# MONGO_URI=mongodb+srv://<username>:<password>@<clusterName>.mongodb.net/<databaseName>?retryWrites=true&w=majority
# For local:
# MONGO_URI=mongodb://localhost:27017/emotionally
MONGO_URI=

# JWT secret used to sign tokens; choose a long random string
JWT_SECRET=change_me_to_a_long_random_value

# Explicit server port (defaults to 5000 if omitted)
PORT=5000

# Example environment variables for Emotionally backend
# Copy this file to .env (same directory) and fill in real values.
# ---------------------------------------------------------------
# MongoDB connection string:
# For Atlas (SRV):
# MONGO_URI=mongodb+srv://<username>:<password>@<clusterName>.mongodb.net/<databaseName>?retryWrites=true&w=majority
# For local:
# MONGO_URI=mongodb://localhost:27017/emotionally
MONGO_URI=

# JWT secret used to sign tokens; choose a long random string
JWT_SECRET=change_me_to_a_long_random_value

# Explicit server port (defaults to 5000 if omitted)
PORT=5000

# Optional host (defaults 127.0.0.1). Set to 0.0.0.0 if deploying in a container.
# HOST=0.0.0.0

# Frontend URL for CORS (include protocol)
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------
# AI Emotion Detection Configuration
# ---------------------------------------------------------------
# Choose your AI provider: 'openai', 'gemini', or 'grok'
AI_PROVIDER=gemini

# === RECOMMENDED: Google Gemini (FREE tier available!) ===
# Get your free API key: https://makersuite.google.com/app/apikey
# Free tier: 60 requests per minute
GEMINI_API_KEY=

# === OpenAI GPT (Paid - requires credits) ===
# Get API key: https://platform.openai.com/api-keys
# Cost: ~$0.0005 per analysis with gpt-3.5-turbo
OPENAI_API_KEY=

# === xAI Grok (Paid) ===
# Get API key: https://x.ai
GROK_API_KEY=

# Optional: Customize OpenAI model
# AI_MODEL=gpt-3.5-turbo
# AI_MODEL=gpt-4

# Note: If no API key is provided, the system will use fallback keyword-based detection
# For production, using a real AI API is highly recommended for better accuracy

# ---------------------------------------------------------------
# Notes:
# - If your password contains special characters like @ or : encode them with percent encoding.
#   Example: myP@ss:word -> myP%40ss%3Aword inside the URI.
# - Ensure the database user has readWrite on the target database (Atlas UI > Database Access).
# - For Atlas, also add your current IP or 0.0.0.0/0 in Network Access > IP Whitelist while testing.

# Frontend URL for CORS (include protocol)
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------
# Notes:
# - If your password contains special characters like @ or : encode them with percent encoding.
#   Example: myP@ss:word -> myP%40ss%3Aword inside the URI.
# - Ensure the database user has readWrite on the target database (Atlas UI > Database Access).
# - For Atlas, also add your current IP or 0.0.0.0/0 in Network Access > IP Whitelist while testing.
